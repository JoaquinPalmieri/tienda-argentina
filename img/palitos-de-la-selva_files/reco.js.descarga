(function($) {
    function initRsiRecoSlick() {
        var $sliders = $('.rsireco-slider');
        if (!$sliders.length) return;

        // Si no está Slick, fallback a scroll nativo
        if (typeof $.fn.slick !== 'function') {
            // Nada: el CSS fallback ya hace el scroll horizontal
            return;
        }

        $sliders.each(function() {
            var $el = $(this);
            if ($el.hasClass('slick-initialized')) return;

            var slides = parseInt($el.data('slides'), 10) || 6;

            $el.slick({
                slidesToShow: slides,
                slidesToScroll: 1,
                infinite: false,
                swipeToSlide: true,
                arrows: true,
                dots: false,
                arrows: true,
                prevArrow: '<button type="button" class="slick-prev rsireco-arrow" aria-label="Previous">‹</button>',
                nextArrow: '<button type="button" class="slick-next rsireco-arrow" aria-label="Next">›</button>',
                adaptiveHeight: false,
                // lazyLoad: 'ondemand', // si cambias <img src> por data-lazy
                responsive: [
                    { breakpoint: 1400, settings: { slidesToShow: Math.min(5, slides) } },
                    { breakpoint: 1200, settings: { slidesToShow: Math.min(3, slides) } },
                    { breakpoint: 992, settings: { slidesToShow: Math.min(3, slides) } },
                    { breakpoint: 768, settings: { slidesToShow: Math.min(2, slides) } },
                    { breakpoint: 480, settings: { slidesToShow: 1 } }
                ]
            });
        });
    }

    // DOM listo
    if (typeof jQuery !== 'undefined') {
        $(initRsiRecoSlick);
        // Por si hay actualizaciones Ajax del carrito en tu theme
        prestashop && prestashop.on && prestashop.on('updatedCart', initRsiRecoSlick);
    }
})(jQuery);