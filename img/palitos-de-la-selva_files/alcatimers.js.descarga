// Para cada temporizador
document.querySelectorAll(".alcatimer").forEach(timer => {
    const daysSpan = timer.querySelector("[data-days]");
    const hoursSpan = timer.querySelector("[data-hours]");
    const minutesSpan = timer.querySelector("[data-minutes]");
    const secondsSpan = timer.querySelector("[data-seconds]");
  
    let totalSeconds =
      parseInt(daysSpan.getAttribute("data-days")) * 86400 +
      parseInt(hoursSpan.getAttribute("data-hours")) * 3600 +
      parseInt(minutesSpan.getAttribute("data-minutes")) * 60 +
      parseInt(secondsSpan.getAttribute("data-seconds"));
  
    function updateCountdown() {
      if (totalSeconds <= 0) {
        daysSpan.textContent = "00";
        hoursSpan.textContent = "00";
        minutesSpan.textContent = "00";
        secondsSpan.textContent = "00";
        clearInterval(interval);
        return;
      }
  
      totalSeconds--;
  
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
  
      daysSpan.textContent = String(days).padStart(2, "0");
      hoursSpan.textContent = String(hours).padStart(2, "0");
      minutesSpan.textContent = String(minutes).padStart(2, "0");
      secondsSpan.textContent = String(seconds).padStart(2, "0");
    }
  
    updateCountdown();
    const interval = setInterval(updateCountdown, 1000);
  });