$('[alt="apmyoutubevideo"]').on("click", function (t) {
    // const isNormalThumb = $(this).closest('div').hasClass('js-qv-mask');
    html = '<div style="display:none" id="apmyoutubevideo"><iframe title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>';
    if ($('#apmyoutubevideo').length == 0) {
        $('body').append($(html));
    }
    h = $('#apmyoutubevideo').first().html();
    o = $(h);
    $(o).attr('src', 'https://www.youtube.com/embed' + $(this).attr('src').replace('https://img.youtube.com/vi', '').replace('/0.jpg', '') + '?autoplay=1');
    $(o).attr('id', 'apmyoutubevideoiframe');
    $('#apmyoutubevideoiframe').remove();
    var target = $('.js-images-container .js-qv-product-cover');
    if ($(target).length == 0) {
        target = $('img.pro_gallery_item').last();
    }
    setTimeout(function(target) {
        $(o).width($(target).width());
        $(o).height($(target).height());
        $(target).after(o).hide();
        setTimeout(function() {
            $('[data-target="#product-modal"]').hide();
            $('#product-modal').modal('hide');
            $('.js-thumb').removeClass('selected');
            $('[alt="apmyoutubevideo"]').addClass('selected');
    
            $('.pro_popup_trigger_box').hide();
        });
    }, 100, target);
});
$(document).on('click', '.js-qv-product-images .thumb-container, .pro_gallery_thumbs_container .curr_combination_thumb', function () {
    if ($(this).attr('alt') != 'apmyoutubevideo') {
        if ($(this).find('[alt="apmyoutubevideo"]').length == 0) {
            $('.js-images-container .js-qv-product-cover').after(o).show();
            $('#apmyoutubevideoiframe').remove();
        }
        $('[data-target="#product-modal"]').show();
    }
});